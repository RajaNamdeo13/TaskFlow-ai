generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  workspaces    Workspace[]
  refreshTokens RefreshToken[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Workspace {
  id         String      @id @default(uuid())
  name       String
  ownerId    String      @map("owner_id")
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blueprints Blueprint[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@map("workspaces")
}

model Blueprint {
  id           String           @id @default(uuid())
  workspaceId  String           @map("workspace_id")
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idea         String
  projectName  String           @map("project_name")
  payload      Json
  source       GenerationSource @default(DEMO)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  exportEvents ExportEvent[]

  @@index([workspaceId, createdAt])
  @@map("blueprints")
}

enum GenerationSource {
  GEMINI
  DEMO
}

model ExportEvent {
  id          String    @id @default(uuid())
  blueprintId String    @map("blueprint_id")
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  format      String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([blueprintId, createdAt])
  @@map("export_events")
}
